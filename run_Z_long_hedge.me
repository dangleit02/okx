# FUTURE HEDGE - LONG
# Dùng testing=true để preview trước khi đổi sang testing=false.

# Mở LONG market khi giá tăng khoảng 0.2% so với currentPrice.
# Không truyền stopLossPrice: tự tính theo stopLossBuyPriceRatio.
curl -X POST 'http://localhost:3030/future-hedge/open-near-current-price/BTC?direction=long&amountUsdt=25&testing=true' \
  -H 'Content-Type: application/json'

# Có thể chỉ định stop-loss thủ công (phải thấp hơn giá entry).
# curl -X POST 'http://localhost:3030/future-hedge/open-near-current-price/BTC?direction=long&amountUsdt=25&stopLossPrice=58000&testing=true' \
#   -H 'Content-Type: application/json'

# 1. Đặt sẵn ladder mở LONG. Mỗi entry luôn có attached stop-loss.
curl -X POST 'http://localhost:3030/future-hedge/buy-trigger-from-min-to-max/BTC?direction=long&testing=true&minPrice=60000&maxPrice=62000&numberOfOrders=5&stopLossPrice=57000' \
  -H 'Content-Type: application/json'

# 2. Xem tất cả vị thế LONG đang mở dạng bảng (dùng format=json để lấy JSON).
curl -X GET 'http://localhost:3030/future-hedge/spot-bought-coins?direction=long&format=table' \
  -H 'Content-Type: text/plain'

# 3. Xem entry orders LONG của một coin.
curl -X GET 'http://localhost:3030/future-hedge/orders-one-coin/BTC?direction=long&intent=open' \
  -H 'Content-Type: application/json'

# 4. Xem close orders LONG của tất cả coin dạng bảng (dùng format=json để lấy JSON).
curl -X GET 'http://localhost:3030/future-hedge/orders-all-coins?direction=long&intent=close&format=table' \
  -H 'Content-Type: text/plain'

# 5. Đặt sẵn TAKE PROFIT LONG tại giá cao hơn currentPrice: limit khi trigger.
curl -X POST 'http://localhost:3030/future-hedge/close-at-price/BTC?direction=long&testing=true&price=65000&percentage=25' \
  -H 'Content-Type: application/json'

# 6. Đặt sẵn STOP LOSS LONG tại giá thấp hơn currentPrice: market khi trigger.
curl -X POST 'http://localhost:3030/future-hedge/stop-loss-at-trigger-price/BTC?direction=long&testing=true&price=58000&percentage=100' \
  -H 'Content-Type: application/json'

# 7. Đặt STOP LOSS market đóng LONG tại khoảng 0.2% dưới currentPrice.
curl -X POST 'http://localhost:3030/future-hedge/stop-loss-near-current-price/BTC?direction=long&testing=true&percentage=100' \
  -H 'Content-Type: application/json'

# Reconcile SL LONG: hủy phần dư, bổ sung phần thiếu, hủy toàn bộ nếu position đã đóng.
curl -X POST 'http://localhost:3030/future-hedge/reconcile-position-stop-loss/BTC?direction=long&testing=true' \
  -H 'Content-Type: application/json'

# 8. Đặt ladder đóng LONG từ 5%-6% dưới current; market khi trigger.
curl -X POST 'http://localhost:3030/future-hedge/protective-close-by-price-steps/BTC?direction=long&testing=true&protectiveCloseOnly=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# 9. Đặt ladder đóng LONG cho coinsForLong.
curl -X POST 'http://localhost:3030/future-hedge/protective-close-by-price-steps-all-coins?direction=long&testing=true&protectiveCloseOnly=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# Preview clean: chỉ tính long protective-close trigger dưới current, không tính entry/TP phía trên current/conditional SL.
curl -X POST 'http://localhost:3030/future-hedge/clean-protective-close-by-price-steps-orders/BTC?direction=long&testing=true' \
  -H 'Content-Type: application/json'

# Preview conditional close orders/stop-loss LONG của BTC, không hủy.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-orders/BTC?direction=long&intent=close&ordType=conditional&testing=true' \
  -H 'Content-Type: application/json'

# WARNING: bỏ dấu # để hủy thật conditional close orders/stop-loss LONG.
# curl -X DELETE 'http://localhost:3030/future-hedge/cancel-orders/BTC?direction=long&intent=close&ordType=conditional&testing=false' \
#   -H 'Content-Type: application/json'

# WARNING: các DELETE trigger với testing=false dưới đây hủy lệnh thật.

# 10. Hủy entry orders LONG của BTC.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-orders/BTC?direction=long&intent=open&ordType=trigger&testing=false' \
  -H 'Content-Type: application/json'

# 11. Alias hủy close orders LONG của BTC.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-orders-one-coin/BTC?direction=long&intent=close&ordType=trigger&testing=false' \
  -H 'Content-Type: application/json'

# 12. Hủy tất cả trigger orders LONG.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-all-orders?direction=long&intent=all&ordType=trigger&testing=false' \
  -H 'Content-Type: application/json'
