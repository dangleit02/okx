# WARNING: hủy thật toàn bộ trigger orders của BTC (cả BUY và SELL).
  curl -X DELETE 'http://localhost:3030/cancel-orders/BTC?ordType=trigger&testing=false' \
    -H "Content-Type: application/json"


# Preview tất cả trigger + conditional orders của BTC, không hủy.
  curl -X DELETE 'http://localhost:3030/cancel-orders/BTC?ordType=all&testing=true' \
    -H "Content-Type: application/json"

# Preview conditional orders của tất cả coin, không hủy.
  curl -X DELETE 'http://localhost:3030/cancel-all-orders?ordType=conditional&testing=true' \
    -H "Content-Type: application/json"

