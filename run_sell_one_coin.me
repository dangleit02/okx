# Global SPOT SL: đọc balance + conditional SL hiện tại, chỉ tạo market SL cho size còn thiếu.
curl -X POST 'http://localhost:3030/ensure-position-stop-loss/BTC?testing=true' \
  -H 'Content-Type: application/json'

# Manual SPOT SL: giá phải thấp hơn current, market khi conditional SL được trigger.
curl -X POST 'http://localhost:3030/stop-loss-at-trigger-price/BTC?price=50000&percentage=100&testing=true' \
  -H 'Content-Type: application/json'

# Near-current SPOT SL: tự đặt conditional market SL khoảng 0.2% dưới current.
curl -X POST 'http://localhost:3030/stop-loss-near-current-price/LTC?percentage=100&testing=false' \
  -H 'Content-Type: application/json'

# Near-current SPOT SL cho ALGO: đặt conditional market SL cho một phần available balance.
