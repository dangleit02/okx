# FUTURE ONEWAY - LONG
# Dùng testing=true để preview trước khi đổi sang testing=false.

# 1. Đặt sẵn ladder mở LONG. Mỗi entry luôn có attached stop-loss.
curl -X POST 'http://localhost:3030/future-oneway/buy-trigger-from-min-to-max/BTC?direction=long&testing=true&minPrice=60000&maxPrice=62000&numberOfOrders=5&stopLossPrice=57000' \
  -H 'Content-Type: application/json'

# 2. Xem tất cả vị thế LONG đang mở.
curl -X GET 'http://localhost:3030/future-oneway/spot-bought-coins?direction=long' \
  -H 'Content-Type: application/json'

# 3. Xem entry orders LONG của BTC.
curl -X GET 'http://localhost:3030/future-oneway/orders-one-coin/BTC?direction=long&intent=open' \
  -H 'Content-Type: application/json'

# 4. Xem close orders LONG của tất cả coin.
curl -X GET 'http://localhost:3030/future-oneway/orders-all-coins?direction=long&intent=close' \
  -H 'Content-Type: application/json'

# 5. TAKE PROFIT LONG: limit khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-trigger-price/BTC?direction=long&testing=true&price=65000&percentage=25' \
  -H 'Content-Type: application/json'

# 6. STOP LOSS LONG: market khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-trigger-price/BTC?direction=long&testing=true&price=58000&percentage=100' \
  -H 'Content-Type: application/json'

# 7. Đặt trigger market đóng LONG quanh currentPrice.
curl -X POST 'http://localhost:3030/future-oneway/sell-all-at-price/BTC?direction=long&testing=true&percentage=100' \
  -H 'Content-Type: application/json'

# 8. Đặt ladder đóng LONG.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-price/BTC?direction=long&testing=true&partialCloseOnRetrace=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# 9. Đặt ladder đóng LONG cho coinsForLong.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-price-all-coins?direction=long&testing=true&partialCloseOnRetrace=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# WARNING: các DELETE dưới đây hủy lệnh thật, không có testing mode.
curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders/BTC?direction=long&intent=open' \
  -H 'Content-Type: application/json'

curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders-one-coin/BTC?direction=long&intent=close' \
  -H 'Content-Type: application/json'

curl -X DELETE 'http://localhost:3030/future-oneway/cancel-all-orders?direction=long&intent=all' \
  -H 'Content-Type: application/json'
