# FUTURE ONEWAY - SHORT
# Dùng testing=true để preview trước khi đổi sang testing=false.

# 1. Đặt sẵn ladder mở SHORT. Mỗi entry luôn có attached stop-loss.
curl -X POST 'http://localhost:3030/future-oneway/buy-trigger-from-min-to-max/BTC?direction=short&testing=true&minPrice=60000&maxPrice=62000&numberOfOrders=5&stopLossPrice=65000' \
  -H 'Content-Type: application/json'

# 2. Xem tất cả vị thế SHORT đang mở.
curl -X GET 'http://localhost:3030/future-oneway/spot-bought-coins?direction=short' \
  -H 'Content-Type: application/json'

# 3. Xem entry orders SHORT của BTC.
curl -X GET 'http://localhost:3030/future-oneway/orders-one-coin/BTC?direction=short&intent=open' \
  -H 'Content-Type: application/json'

# 4. Xem close orders SHORT của tất cả coin.
curl -X GET 'http://localhost:3030/future-oneway/orders-all-coins?direction=short&intent=close' \
  -H 'Content-Type: application/json'

# 5. TAKE PROFIT SHORT: limit khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-trigger-price/BTC?direction=short&testing=true&price=57000&percentage=25' \
  -H 'Content-Type: application/json'

# 6. STOP LOSS SHORT: market khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-trigger-price/BTC?direction=short&testing=true&price=65000&percentage=100' \
  -H 'Content-Type: application/json'

# 7. Đặt trigger market đóng SHORT quanh currentPrice.
curl -X POST 'http://localhost:3030/future-oneway/sell-all-at-price/BTC?direction=short&testing=true&percentage=100' \
  -H 'Content-Type: application/json'

# 8. Đặt ladder đóng SHORT.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-price/BTC?direction=short&testing=true&partialCloseOnRetrace=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# 9. Đặt ladder đóng SHORT cho coinsForShort.
curl -X POST 'http://localhost:3030/future-oneway/sell-at-price-all-coins?direction=short&testing=true&partialCloseOnRetrace=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# WARNING: các DELETE dưới đây hủy lệnh thật, không có testing mode.
curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders/BTC?direction=short&intent=open' \
  -H 'Content-Type: application/json'

curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders-one-coin/BTC?direction=short&intent=close' \
  -H 'Content-Type: application/json'

curl -X DELETE 'http://localhost:3030/future-oneway/cancel-all-orders?direction=short&intent=all' \
  -H 'Content-Type: application/json'
