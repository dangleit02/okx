# FUTURE ONEWAY - SHORT
# Dùng testing=true để preview trước khi đổi sang testing=false.

# Mở SHORT market khi giá giảm khoảng 0.2% so với currentPrice.
# Không truyền stopLossPrice: tự tính theo stopLossBuyPriceRatio.
curl -X POST 'http://localhost:3030/future-oneway/open-near-current-price/BTC?direction=short&amountUsdt=25&testing=true' \
  -H 'Content-Type: application/json'

# Có thể chỉ định stop-loss thủ công (phải cao hơn giá entry).
# curl -X POST 'http://localhost:3030/future-oneway/open-near-current-price/BTC?direction=short&amountUsdt=25&stopLossPrice=65000&testing=true' \
#   -H 'Content-Type: application/json'

# 1. Đặt sẵn ladder mở SHORT. Mỗi entry luôn có attached stop-loss.
curl -X POST 'http://localhost:3030/future-oneway/buy-trigger-from-min-to-max/BTC?direction=short&testing=true&minPrice=60000&maxPrice=62000&numberOfOrders=5&stopLossPrice=65000' \
  -H 'Content-Type: application/json'

# 2. Xem tất cả vị thế SHORT đang mở dạng bảng (dùng format=json để lấy JSON).
curl -X GET 'http://localhost:3030/future-oneway/spot-bought-coins?direction=short&format=table' \
  -H 'Content-Type: text/plain'

# 3. Xem entry orders SHORT của BTC.
curl -X GET 'http://localhost:3030/future-oneway/orders-one-coin/BTC?direction=short&intent=open' \
  -H 'Content-Type: application/json'

# 4. Xem close orders SHORT của tất cả coin dạng bảng (dùng format=json để lấy JSON).
curl -X GET 'http://localhost:3030/future-oneway/orders-all-coins?direction=short&intent=close&format=table' \
  -H 'Content-Type: text/plain'

# 5. TAKE PROFIT SHORT: limit khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/close-at-price/BTC?direction=short&testing=true&price=57000&percentage=25' \
  -H 'Content-Type: application/json'

# 6. STOP LOSS SHORT: market khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/stop-loss-at-trigger-price/BTC?direction=short&testing=true&price=65000&percentage=100' \
  -H 'Content-Type: application/json'

# 7. Đặt STOP LOSS market đóng SHORT tại khoảng 0.2% trên currentPrice.
curl -X POST 'http://localhost:3030/future-oneway/stop-loss-near-current-price/BTC?direction=short&testing=true&percentage=100' \
  -H 'Content-Type: application/json'

# Reconcile SL SHORT thành một whole-position market SL với closeFraction=1.
curl -X POST 'http://localhost:3030/future-oneway/reconcile-position-stop-loss/BTC?direction=short&testing=true' \
  -H 'Content-Type: application/json'

# 8. Đặt ladder đóng SHORT từ 5%-6% trên current; market khi trigger.
curl -X POST 'http://localhost:3030/future-oneway/protective-close-by-price-steps/BTC?direction=short&testing=true&protectiveCloseOnly=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# 9. Đặt ladder đóng SHORT cho coinsForShort.
curl -X POST 'http://localhost:3030/future-oneway/protective-close-by-price-steps-all-coins?direction=short&testing=true&protectiveCloseOnly=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# Preview clean: chỉ tính short protective-close trigger trên current, không tính entry/TP phía dưới current/conditional SL.
curl -X POST 'http://localhost:3030/future-oneway/clean-protective-close-by-price-steps-orders/BTC?direction=short&testing=true' \
  -H 'Content-Type: application/json'

# Preview conditional close orders/stop-loss SHORT của BTC, không hủy.
curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders/BTC?direction=short&intent=close&ordType=conditional&testing=true' \
  -H 'Content-Type: application/json'

# WARNING: bỏ dấu # để hủy thật conditional close orders/stop-loss SHORT.
# curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders/BTC?direction=short&intent=close&ordType=conditional&testing=false' \
#   -H 'Content-Type: application/json'

# WARNING: các DELETE trigger với testing=false dưới đây hủy lệnh thật.
curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders/BTC?direction=short&intent=open&ordType=trigger&testing=false' \
  -H 'Content-Type: application/json'

curl -X DELETE 'http://localhost:3030/future-oneway/cancel-orders-one-coin/BTC?direction=short&intent=close&ordType=trigger&testing=false' \
  -H 'Content-Type: application/json'

curl -X DELETE 'http://localhost:3030/future-oneway/cancel-all-orders?direction=short&intent=all&ordType=trigger&testing=false' \
  -H 'Content-Type: application/json'
