# FUTURE HEDGE - SHORT
# Dùng testing=true để preview trước khi đổi sang testing=false.

# 1. Đặt sẵn ladder mở SHORT. Mỗi entry luôn có attached stop-loss.
curl -X POST 'http://localhost:3030/future-hedge/buy-trigger-from-min-to-max/BTC?direction=short&testing=true&minPrice=60000&maxPrice=62000&numberOfOrders=5&stopLossPrice=65000' \
  -H 'Content-Type: application/json'

# 2. Xem tất cả vị thế SHORT đang mở.
curl -X GET 'http://localhost:3030/future-hedge/spot-bought-coins?direction=short' \
  -H 'Content-Type: application/json'

# 3. Xem entry orders SHORT của một coin.
curl -X GET 'http://localhost:3030/future-hedge/orders-one-coin/BTC?direction=short&intent=open' \
  -H 'Content-Type: application/json'

# 4. Xem close orders SHORT của tất cả coin.
curl -X GET 'http://localhost:3030/future-hedge/orders-all-coins?direction=short&intent=close' \
  -H 'Content-Type: application/json'

# 5. Đặt sẵn TAKE PROFIT SHORT tại giá thấp hơn currentPrice: limit khi trigger.
curl -X POST 'http://localhost:3030/future-hedge/close-at-price/BTC?direction=short&testing=true&price=57000&percentage=25' \
  -H 'Content-Type: application/json'

# 6. Đặt sẵn STOP LOSS SHORT tại giá cao hơn currentPrice: market khi trigger.
curl -X POST 'http://localhost:3030/future-hedge/stop-loss-at-trigger-price/BTC?direction=short&testing=true&price=65000&percentage=100' \
  -H 'Content-Type: application/json'

# 7. Đặt STOP LOSS market đóng SHORT tại khoảng 0.2% trên currentPrice.
curl -X POST 'http://localhost:3030/future-hedge/stop-loss-near-current-price/BTC?direction=short&testing=true&percentage=100' \
  -H 'Content-Type: application/json'

# 8. Đặt ladder đóng SHORT từ 5%-6% trên current; market khi trigger.
curl -X POST 'http://localhost:3030/future-hedge/protective-close-by-price-steps/BTC?direction=short&testing=true&protectiveCloseOnly=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# 9. Đặt ladder đóng SHORT cho coinsForShort.
curl -X POST 'http://localhost:3030/future-hedge/protective-close-by-price-steps-all-coins?direction=short&testing=true&protectiveCloseOnly=true&justOneOrder=false' \
  -H 'Content-Type: application/json'

# Preview clean: chỉ tính short protective-close trigger trên current, không tính entry/TP phía dưới current/conditional SL.
curl -X POST 'http://localhost:3030/future-hedge/clean-protective-close-by-price-steps-orders/BTC?direction=short&testing=true' \
  -H 'Content-Type: application/json'

# WARNING: các DELETE dưới đây hủy lệnh thật, không có testing mode.

# 10. Hủy entry orders SHORT của BTC.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-orders/BTC?direction=short&intent=open' \
  -H 'Content-Type: application/json'

# 11. Alias hủy close orders SHORT của BTC.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-orders-one-coin/BTC?direction=short&intent=close' \
  -H 'Content-Type: application/json'

# 12. Hủy tất cả trigger orders SHORT.
curl -X DELETE 'http://localhost:3030/future-hedge/cancel-all-orders?direction=short&intent=all' \
  -H 'Content-Type: application/json'
